# VATSIM ATC Tracker: every option, with its default.
# Copy the block into your AppDaemon apps.yaml. Only vatsim_cid is required;
# delete or leave commented anything you do not want to change.
#
# Paths are read INSIDE the AppDaemon add-on container:
#   /homeassistant   your Home Assistant config directory
#   /config          the AppDaemon add-on's own folder (NOT your HA config)

vatsim_atc_tracker:
  module: vatsim_atc_tracker
  class: VatsimAtcTracker

  # REQUIRED. Your numeric VATSIM CID. The app follows this pilot only.
  vatsim_cid: your_cid

  # --- Navigation data (optional; enables route plotting, airport ATIS distance, NAT tracks)
  # Folder holding earth_fix.dat, earth_nav.dat, earth_awy.dat and
  # earth_aptmeta.dat in X-Plane 12 format. Default: unset (route plotting off).
  # A folder with none of those files is logged as an ERROR.
  # navdata_path: /homeassistant/vatsim/navdata
  # Days between scheduled reloads. Changed files are also picked up within the hour. Default 30.
  # navdata_refresh_interval_days: 30

  # --- Approach / departure boundaries (optional)
  # A SimAware TRACON Project GeoJSON file, or a folder of *.geojson files.
  # Default: unset (centre and FSS sectors only).
  # simaware_boundaries_path: /homeassistant/vatsim/simaware/TRACONBoundaries.geojson
  # Above this altitude (feet) approach/departure sectors are ignored. Default 18000.
  # app_dep_altitude_gate_ft: 18000
  # Dead band around that altitude, feet, so a level-off at the gate does not flap. Default 500.
  # altitude_hysteresis_feet: 500

  # --- Polling and feed health
  # Seconds between polls of the VATSIM feed. The feed regenerates every 15 s;
  # lower values are accepted with a warning and gain nothing. Default 18.
  # poll_interval_seconds: 18
  # Consecutive polls without your CID before you count as disconnected. Default 3.
  # presence_absent_after_misses: 3
  # The feed is stale when older than 15 s x multiplier + poll interval + grace. Defaults 2.0 and 45 s.
  # stale_feed_multiplier: 2.0
  # stale_feed_grace_seconds: 45

  # --- Lookahead (next sector prediction)
  # Minutes ahead to project your track. Default 10.
  # lookahead_minutes: 10
  # Below this groundspeed (knots) lookahead is skipped (taxiing). Default 30.
  # minimum_groundspeed_knots: 30
  # Polls of heading history required, minimum 2. Default 3.
  # heading_stability_window_polls: 3
  # Largest heading change (degrees) between polls still treated as stable. Default 20.
  # heading_stability_max_delta_deg: 20

  # --- Session track (breadcrumb trail on the map)
  # Points kept. Default 300.
  # track_history_max_points: 300
  # A point is recorded after this distance (nm) or this time (s), whichever comes first. Defaults 1.0 and 30.
  # track_history_min_distance_nm: 1.0
  # track_history_min_seconds: 30

  # --- Airport ATIS card
  # Arrival ATIS shows inside this distance (nm). Default 100.
  # destination_range_nm: 100
  # On the ground within this distance (nm) of the filed departure, its ATIS shows. Default 5.
  # departure_near_nm: 5
  # Groundspeed (knots) above which a takeoff is being confirmed. Default 40.
  # takeoff_groundspeed_knots: 40

  # --- Data sources (change only if a publisher moves its files)
  # VATSIM status document the feed URL is read from. Blank or null: use the built-in feed URL.
  # vatsim_status_url: https://status.vatsim.net/status.json
  # vatspy_boundaries_url: https://raw.githubusercontent.com/vatsimnetwork/vatspy-data-project/master/Boundaries.geojson
  # vatspy_dat_url: https://raw.githubusercontent.com/vatsimnetwork/vatspy-data-project/master/VATSpy.dat
  # Days between boundary refreshes. Default 7.
  # geometry_refresh_interval_days: 7
  # North Atlantic Tracks. Blank or null turns track expansion off. Needs navdata_path.
  # nat_tracks_url: https://nattrak.vatsim.net/api/tracks
  # Minutes between track refreshes. Default 30.
  # nat_track_refresh_interval_minutes: 30

  # --- Saved state
  # File holding your last aircraft position so the map survives a restart.
  # It contains your CID, callsign and position. Default: vatsim_last_aircraft.json
  # next to the app file.
  # last_aircraft_path: /config/apps/vatsim_atc_tracker/vatsim_last_aircraft.json
